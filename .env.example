# Sprint M.1 — Spotify Beat Sync (music-beat-sync branch only).
# Copy this file to .env.local (gitignored via *.local rule) and paste
# the Client ID from your Spotify Developer Dashboard app.
#
# 1. https://developer.spotify.com/dashboard → Create App
# 2. App name: "Subutai Beat Sync"
# 3. Redirect URIs (add BOTH):
#       https://b1toks.github.io/subutai/
#       http://localhost:5173/
# 4. Copy the Client ID and paste it below.
#
# The Client ID is a public identifier — safe to expose in browser bundles
# (PKCE flow doesn't need the Client Secret). Even so, .env.local keeps it
# out of git history during development.
VITE_SPOTIFY_CLIENT_ID=
