rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /displayNames/{name} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /game_starts/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /feedback/{id} {
      allow read: if request.auth != null
                  && resource.data.playerId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.playerId == request.auth.uid
                    && request.resource.data.type in ['game', 'general'];
      allow update, delete: if false;
    }

    match /training_games/{id} {
      allow read: if request.auth != null;
      // DEF-11: was `if true` (world-writable spam vector). The app signs in
      // anonymously before any auto-play write, so gating on auth is safe.
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /mm_queue/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.matchCode == null;
      // Owner may rewrite their own entry (re-queue). A FOREIGN writer may
      // only perform the claim: stamp matchCode+claimedBy on a still-
      // unclaimed entry, nothing else.
      allow update: if request.auth != null && (
        request.auth.uid == uid
        || (resource.data.matchCode == null
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['matchCode', 'claimedBy']))
      );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /matches/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.host.uid == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.guest == null;

      // DEF-8 (partial hardening). Chess legality can't be expressed in
      // rules — appended-move validity and turn ownership still need a
      // trusted server / Cloud Function and remain open. What IS enforced
      // here closes the highest-integrity holes without touching the
      // log-append path legitimate play depends on:
      //   - identity fields (host, chess960Id, seed, code) are immutable;
      //   - guest is write-once (null -> value, then frozen), so nobody can
      //     rewrite the opponent's participant record;
      //   - outcome is write-once, so a client can't force or flip a result.
      // All three legit update paths (guest join, move append, outcome
      // write) satisfy these: join only fills a null guest, moves touch
      // neither guest nor outcome, and outcome writes only fill a null
      // outcome.
      allow update: if request.auth != null
        && request.resource.data.host == resource.data.host
        && request.resource.data.chess960Id == resource.data.chess960Id
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.code == resource.data.code
        && (resource.data.guest == null
            || request.resource.data.guest == resource.data.guest)
        && (resource.data.outcome == null
            || request.resource.data.outcome == resource.data.outcome)
        && (
          resource.data.host.uid == request.auth.uid
          || (resource.data.guest != null && resource.data.guest.uid == request.auth.uid)
          || (resource.data.status == 'waiting'
              && resource.data.guest == null
              && request.resource.data.guest != null
              && request.resource.data.guest.uid == request.auth.uid)
        );

      allow delete: if false;
    }
  }
}