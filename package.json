{
  "name": "subutai",
  "private": true,
  "version": "1.1.3",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh": "vite build",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-subutai \"node --import ./tests/rules/register.mjs --test --test-isolation=none tests/rules/rules.test.mjs tests/rules/attacks.test.mjs tests/rules/clock.test.mjs tests/rules/v102.test.mjs && node --import ./tests/rules/expect-fixed.mjs --test --test-isolation=none tests/rules/carryover.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vercel/analytics": "2.0.1",
    "essentia.js": "^0.1.3",
    "firebase": "^12.13.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.32.1",
    "gh-pages": "^6.2.0",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
